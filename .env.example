# Anthropic API key (required). https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Model id. Defaults to claude-sonnet-4-5 if unset (see src/lib/ai/client.ts).
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: custom API base url (proxies / gateways)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# PostgreSQL connection string (required at build-time DB tasks and at runtime).
# `prisma generate` does not need it, so `npm install` succeeds without it.
DATABASE_URL="postgresql://user:password@localhost:5432/ai_creativity"
