# Which AI backend to use: "anthropic" (default) or "ollama".
# ollama needs no API key and runs entirely on your machine.
AI_PROVIDER=anthropic

# --- anthropic (AI_PROVIDER=anthropic) --------------------------------------

# Anthropic API key. https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# Model id. Defaults to claude-sonnet-4-5 if unset (see src/lib/ai/client.ts).
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: custom API base url (proxies / gateways)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- ollama (AI_PROVIDER=ollama) --------------------------------------------

# Install: https://ollama.com/download , then in a terminal:
#   ollama pull qwen2.5:7b
#   ollama serve
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

# Optional: override the request timeout (ms). Local CPU inference is much
# slower than a hosted API; the app already defaults to 180000ms for ollama.
# AI_REQUEST_TIMEOUT_MS=180000

# --- database ----------------------------------------------------------------

# SQLite database
DATABASE_URL="file:./dev.db"
